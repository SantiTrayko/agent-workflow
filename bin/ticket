#!/usr/bin/env bash
# ticket — organiza tickets multi-repo con git worktrees + docs de fase
#
#   ticket new <ID> <slug> [--link <url>] [--source <plataforma>]
#                               ticket manual, opcionalmente vinculado a una tarea de cualquier
#                               plataforma (ej: ticket new CAN-123 export-pdf --link https://seeble.io/...)
#   ticket new <repo>#<N> [slug] ticket desde un issue de GitHub (ej: ticket new growcore#12)
#   ticket link <url> [--source <plataforma>]  vincula el ticket actual a una tarea
#   ticket add <repo> [...]     crea un worktree por repo dentro del ticket (misma branch)
#   ticket init <repo>          crea .agent-workflow.md (config local del flujo, nunca se commitea)
#   ticket ls                   lista tickets activos con su fase y repos
#   ticket path <ID>            imprime la ruta del ticket (cd "$(ticket path 12)")
#   ticket done                 quita los worktrees (si está todo pusheado) y archiva el ticket
#   ticket vault                crea el vault de Obsidian en TICKETS_ROOT (si no existe)
#
# Config por variables de entorno (ponelas en ~/.zshrc si querés cambiarlas):
#   TICKETS_ROOT          default: ~/tickets
#   REPOS_ROOT            default: ~/projects
#   TICKET_BRANCH_PREFIX  fuerza el prefijo de branch. Si no está, manda el "Branch:" de
#                         .agent-workflow.md del repo, y si tampoco hay, "feat"
set -euo pipefail

TICKETS_ROOT="${TICKETS_ROOT:-$HOME/tickets}"
REPOS_ROOT="${REPOS_ROOT:-$HOME/projects}"
DEFAULT_BRANCH_PREFIX="feat"
CONFIG_FILE=".agent-workflow.md"

# Resolver la carpeta del kit aunque el script se llame por symlink
SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
KIT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
TEMPLATES="$KIT_DIR/templates"

die() { echo "ticket: $*" >&2; exit 1; }

usage() {
  # The header comment block is the help text
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$SELF"
}

slugify() {
  local s
  # Sacar tildes (á→a, ñ→n) con perl, que viene en macOS; si falla, queda el texto original
  s="$(printf '%s' "$1" | perl -CS -MUnicode::Normalize -pe '$_ = NFD($_); s/\p{Mn}//g' 2>/dev/null || printf '%s' "$1")"
  printf '%s' "$s" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40 | sed -E 's/-+$//'
}

find_ticket_dir() {
  local d="${1:-$PWD}"
  while [ "$d" != "/" ]; do
    if [ -f "$d/.ticket" ]; then echo "$d"; return 0; fi
    d="$(dirname "$d")"
  done
  return 1
}

load_ticket() {
  T="$(find_ticket_dir)" || die "no estás dentro de una carpeta de ticket (usá 'ticket new' o 'cd \"\$(ticket path <ID>)\"')"
  # shellcheck disable=SC1091
  . "$T/.ticket"
}

# Sets (or adds) a KEY="value" line in a .ticket file; the file is sourced, so the value is escaped
set_ticket_var() {
  local file="$1" key="$2" val tmp
  val="$(printf '%s' "$3" | sed -e 's/[\\"$`]/\\&/g')"
  tmp="$(mktemp)"
  grep -v "^$key=" "$file" > "$tmp" || true
  printf '%s="%s"\n' "$key" "$val" >> "$tmp"
  mv "$tmp" "$file"
}

save_repos() {
  set_ticket_var "$T/.ticket" REPOS "$REPOS"
  set_front repos "[$(printf '%s' "$REPOS" | sed 's/ /, /g')]"
}

# Branch prefix from the "Branch:" line of a repo config (e.g. "feature/<id>-<slug>" -> "feature")
config_branch_prefix() {
  local cfg="$1/$CONFIG_FILE" prefix
  [ -f "$cfg" ] || return 0
  prefix="$(sed -n -E 's/^- \*\*Branch:\*\* *`?([A-Za-z0-9._-]+)\/.*/\1/p' "$cfg" | head -1)"
  printf '%s' "$prefix"
}

# Prints "<prefix> <origin>": the env var wins, then the repo config, then the default
resolve_branch_prefix() {
  local repo_dir="${1:-}" prefix
  if [ -n "${TICKET_BRANCH_PREFIX:-}" ]; then echo "$TICKET_BRANCH_PREFIX env"; return; fi
  [ -n "$repo_dir" ] && prefix="$(config_branch_prefix "$repo_dir")"
  if [ -n "${prefix:-}" ]; then echo "$prefix config"; else echo "$DEFAULT_BRANCH_PREFIX default"; fi
}

# Platform name from a task URL: github.com -> github, seeble.io -> seeble, acme.atlassian.net -> atlassian
source_from_url() {
  printf '%s' "$1" | sed -E 's|^[a-zA-Z]+://||; s|[/?#].*||; s|:.*||; s|^www\.||' \
    | awk -F. '{ print (NF >= 2 ? $(NF-1) : $0) }' | tr '[:upper:]' '[:lower:]'
}

# Keeps the config out of every commit: info/exclude lives in the common git dir, shared by all worktrees
ensure_config_excluded() {
  local src="$1" common exclude
  common="$(git -C "$src" rev-parse --path-format=absolute --git-common-dir)"
  exclude="$common/info/exclude"
  mkdir -p "$common/info"
  grep -qxF "/$CONFIG_FILE" "$exclude" 2>/dev/null || echo "/$CONFIG_FILE" >> "$exclude"
}

# Symlinks the main checkout config into a worktree so there is a single copy to edit
link_config() {
  local src="$1" dest="$2"
  # Already there: committed in the repo, or linked by a previous run
  if [ -e "$dest/$CONFIG_FILE" ] || [ -L "$dest/$CONFIG_FILE" ]; then return 0; fi
  [ -f "$src/$CONFIG_FILE" ] || return 1
  ensure_config_excluded "$src"
  ln -s "$src/$CONFIG_FILE" "$dest/$CONFIG_FILE"
}

# Actualiza un campo del frontmatter de status.md (lo lee Obsidian)
set_front() {
  local key="$1" val="$2" tmp
  tmp="$(mktemp)"
  awk -v k="$key" -v v="$val" '
    NR==1 && $0=="---" { infm=1; print; next }
    infm && $0=="---" { infm=0; print; next }
    infm && index($0, k":")==1 { print k": "v; next }
    { print }
  ' "$T/status.md" > "$tmp" && mv "$tmp" "$T/status.md"
}

# Crea el vault de Obsidian en TICKETS_ROOT la primera vez
ensure_vault() {
  local src="$KIT_DIR/obsidian"
  [ -d "$src" ] || return 0
  mkdir -p "$TICKETS_ROOT"
  [ -d "$TICKETS_ROOT/.obsidian" ] || cp -R "$src/dot-obsidian" "$TICKETS_ROOT/.obsidian"
  [ -e "$TICKETS_ROOT/Tickets.base" ] || cp "$src/Tickets.base" "$TICKETS_ROOT/Tickets.base"
  [ -e "$TICKETS_ROOT/Inicio.md" ] || cp "$src/Inicio.md" "$TICKETS_ROOT/Inicio.md"
}

log_status() {
  printf -- '- %s — %s\n' "$(date +%F)" "$1" >> "$T/status.md"
}

# Crea la carpeta del ticket a partir de las plantillas
make_ticket_dir() {
  local id="$1" name="$2" branch="$3" slug="$4" prefix_from="$5"
  local dir="$TICKETS_ROOT/$name"
  [ -e "$dir" ] && die "ya existe $dir"
  [ -d "$TEMPLATES" ] || die "no encuentro las plantillas en $TEMPLATES"
  ensure_vault
  mkdir -p "$dir"
  # SOURCE/SOURCE_URL: task on any platform. ISSUE*: only GitHub issues (used for Closes #N)
  # BRANCH_PREFIX_FROM=default lets the first `ticket add` adopt the prefix of the repo config
  cat > "$dir/.ticket" <<EOF
ID="$id"
SLUG="$slug"
BRANCH="$branch"
BRANCH_PREFIX_FROM="$prefix_from"
REPOS_ROOT="$REPOS_ROOT"
SOURCE=""
SOURCE_URL=""
ISSUE=""
ISSUE_URL=""
ISSUE_REPO=""
REPOS=""
EOF
  local f
  for f in spec plan decisions status; do
    sed -e "s|{{ID}}|$id|g" -e "s|{{SLUG}}|$slug|g" \
        -e "s|{{BRANCH}}|$branch|g" -e "s|{{DATE}}|$(date +%F)|g" \
        "$TEMPLATES/$f.md" > "$dir/$f.md"
  done
  echo "$dir"
}

# Links a ticket dir to a task URL on any platform (.ticket, status frontmatter and spec)
set_link() {
  local dir="$1" url="$2" src="${3:-}"
  [ -n "$src" ] || src="$(source_from_url "$url")"
  [ -n "$src" ] || die "no pude deducir la plataforma de $url: pasala con --source <nombre>"
  set_ticket_var "$dir/.ticket" SOURCE "$src"
  set_ticket_var "$dir/.ticket" SOURCE_URL "$url"
  (T="$dir"; set_front issue "\"$url\"")
  # Replace an existing link line; otherwise add it above the "Ticket original" placeholder
  awk -v u="$url" -v has="$(grep -c '^\*\*Ticket:\*\* ' "$dir/spec.md" || true)" '
    index($0, "**Ticket:** ") == 1 { print "**Ticket:** " u; next }
    has == 0 && /^_\(pegado tal cual llegó\)_$/ && !done { print "**Ticket:** " u; print ""; done=1 }
    { print }
  ' "$dir/spec.md" > "$dir/spec.md.tmp" && mv "$dir/spec.md.tmp" "$dir/spec.md"
  printf -- '- %s — vinculado a %s: %s\n' "$(date +%F)" "$src" "$url" >> "$dir/status.md"
}

# Parses --link/--source out of the args; positional args are left in POSITIONAL
parse_link_flags() {
  LINK_URL="" LINK_SOURCE="" POSITIONAL=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --link)   [ $# -ge 2 ] || die "--link necesita una URL"; LINK_URL="$2"; shift 2 ;;
      --source) [ $# -ge 2 ] || die "--source necesita un nombre"; LINK_SOURCE="$(slugify "$2")"; shift 2 ;;
      --*)      die "opción desconocida: $1" ;;
      *)        POSITIONAL+=("$1"); shift ;;
    esac
  done
}

cmd_new() {
  [ $# -ge 1 ] || die "uso: ticket new <ID> <slug> [--link <url>]  |  ticket new <repo>#<N> [slug]"
  case "$1" in
    *#*) cmd_new_issue "$@" ;;
    *)   cmd_new_manual "$@" ;;
  esac
}

cmd_new_manual() {
  parse_link_flags "$@"
  set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"
  [ $# -ge 2 ] || die "uso: ticket new <ID> <slug> [--link <url>]   ej: ticket new CAN-123 export-pdf"
  local id="$1" slug prefix prefix_from
  slug="$(slugify "$2")"
  # No repo yet: the env var or the default, adjusted later by the first `ticket add`
  read -r prefix prefix_from <<< "$(resolve_branch_prefix)"
  local name="$id-$slug" branch="$prefix/$id-$slug" dir
  dir="$(make_ticket_dir "$id" "$name" "$branch" "$slug" "$prefix_from")"
  [ -z "$LINK_URL" ] || set_link "$dir" "$LINK_URL" "$LINK_SOURCE"
  echo "✓ Ticket creado: $dir"
  if [ "$prefix_from" = default ]; then
    echo "  Branch: $branch (el prefijo se ajusta al de la config del primer repo que agregues)"
  else
    echo "  Branch: $branch"
  fi
  [ -z "$LINK_URL" ] || echo "  Tarea: $LINK_URL"
  echo "  Siguiente: cd \"\$(ticket path $id)\" y en el agente /flow:refine"
}

cmd_link() {
  parse_link_flags "$@"
  [ ${#POSITIONAL[@]} -eq 0 ] || LINK_URL="${POSITIONAL[0]}"
  [ -n "$LINK_URL" ] || die "uso: ticket link <url> [--source <plataforma>]"
  load_ticket
  set_link "$T" "$LINK_URL" "$LINK_SOURCE"
  echo "✓ $ID vinculado a $LINK_URL"
}

cmd_new_issue() {
  local repo="${1%%#*}" num="${1##*#}" slug="${2:-}"
  [ -n "$repo" ] && [ -n "$num" ] || die "uso: ticket new <repo>#<N>   ej: ticket new growcore#12"
  case "$num" in *[!0-9]*) die "el número de issue tiene que ser numérico: $num" ;; esac
  local src="$REPOS_ROOT/$repo"
  git -C "$src" rev-parse --git-dir >/dev/null 2>&1 || die "$src no es un repo git"
  command -v gh >/dev/null 2>&1 || die "necesito la CLI de GitHub: brew install gh && gh auth login"

  local title url body_file
  title="$(cd "$src" && gh issue view "$num" --json title -q .title)" || die "no pude leer el issue #$num (¿gh auth login? ¿el repo tiene remoto en GitHub?)"
  url="$(cd "$src" && gh issue view "$num" --json url -q .url)"
  body_file="$(mktemp)"
  (cd "$src" && gh issue view "$num" --json body -q .body) > "$body_file"

  [ -n "$slug" ] || slug="$(slugify "$title")"
  [ -n "$slug" ] || slug="issue"
  slug="$(slugify "$slug")"
  local prefix prefix_from
  # The issue repo is known up front, so its config sets the prefix right away
  read -r prefix prefix_from <<< "$(resolve_branch_prefix "$src")"
  local id="#$num" name="$repo-$num-$slug" branch="$prefix/$num-$slug" dir
  dir="$(make_ticket_dir "$id" "$name" "$branch" "$slug" "$prefix_from")"

  # Datos del issue en .ticket y en el spec
  set_ticket_var "$dir/.ticket" ISSUE "$num"
  set_ticket_var "$dir/.ticket" ISSUE_URL "$url"
  set_ticket_var "$dir/.ticket" ISSUE_REPO "$repo"
  set_ticket_var "$dir/.ticket" SOURCE github
  set_ticket_var "$dir/.ticket" SOURCE_URL "$url"
  {
    echo "**Issue:** [#$num $title]($url)"
    echo
    cat "$body_file"
  } > "$body_file.full"
  awk -v f="$body_file.full" '
    /^_\(pegado tal cual llegó\)_$/ { while ((getline l < f) > 0) print l; next } { print }
  ' "$dir/spec.md" > "$dir/spec.md.tmp" && mv "$dir/spec.md.tmp" "$dir/spec.md"
  rm -f "$body_file" "$body_file.full"
  printf -- '- %s — creado desde el issue #%s\n' "$(date +%F)" "$num" >> "$dir/status.md"
  (T="$dir"; set_front issue "\"$url\""; set_front titulo "\"$(printf '%s' "$title" | sed 's/"/\\"/g')\"")

  echo "✓ Ticket creado desde #$num: $title"
  echo "  $dir"
  echo "  Branch: $branch"
  # El repo del issue entra siempre en el alcance
  (cd "$dir" && "$SELF" add "$repo")
  echo "  Siguiente: cd \"\$(ticket path $num)\" y en el agente /flow:refine (el issue ya está en spec.md)"
}

cmd_add() {
  [ $# -ge 1 ] || die "uso: ticket add <repo> [repo...]   (nombres de carpeta dentro de $REPOS_ROOT)"
  load_ticket
  local repo src dest base prefix prefix_from
  for repo in "$@"; do
    src="$REPOS_ROOT/$repo"
    dest="$T/.wt/$repo"
    mkdir -p "$T/.wt"
    git -C "$src" rev-parse --git-dir >/dev/null 2>&1 || die "$src no es un repo git"
    git -C "$src" rev-parse --verify HEAD >/dev/null 2>&1 || die "$repo no tiene commits todavía (hacé un commit inicial)"
    if [ -e "$dest" ]; then
      # Re-running add on an existing worktree links a config created after it
      link_config "$src" "$dest" && echo "· $repo ya está en el ticket" \
        || echo "· $repo ya está en el ticket (sin $CONFIG_FILE: ticket init $repo)"
      continue
    fi

    # The first repo of a ticket created with the default prefix adopts its config prefix
    if [ -z "$REPOS" ] && [ "${BRANCH_PREFIX_FROM:-}" = default ]; then
      read -r prefix prefix_from <<< "$(resolve_branch_prefix "$src")"
      if [ "$prefix_from" = config ] && [ "${BRANCH%%/*}" != "$prefix" ]; then
        BRANCH="$prefix/${BRANCH#*/}"
        set_ticket_var "$T/.ticket" BRANCH "$BRANCH"
        set_front branch "$BRANCH"
        echo "· branch ajustada a la config de $repo: $BRANCH"
      fi
      BRANCH_PREFIX_FROM="$prefix_from"
      set_ticket_var "$T/.ticket" BRANCH_PREFIX_FROM "$BRANCH_PREFIX_FROM"
    fi

    # Traer lo último del remoto si hay (best effort, sin cortar si no hay red)
    git -C "$src" fetch --quiet origin 2>/dev/null || true

    if git -C "$src" show-ref --verify --quiet "refs/heads/$BRANCH"; then
      git -C "$src" worktree add "$dest" "$BRANCH"
    else
      # Partir de la rama default del remoto si existe; si no, del HEAD local
      base="$(git -C "$src" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo HEAD)"
      # --no-track: que la branch nueva no quede apuntando a main como upstream
      git -C "$src" worktree add --no-track -b "$BRANCH" "$dest" "$base"
    fi

    case " $REPOS " in *" $repo "*) ;; *) REPOS="${REPOS:+$REPOS }$repo" ;; esac
    save_repos
    log_status "worktree agregado: $repo"
    link_config "$src" "$dest" \
      || echo "  ! $repo no tiene $CONFIG_FILE (las skills usan defaults). Creala con: ticket init $repo y corré de nuevo ticket add $repo"
    echo "✓ $repo → $dest ($BRANCH)"
  done
}

cmd_init() {
  [ $# -eq 1 ] || die "uso: ticket init <repo>"
  local src="$REPOS_ROOT/$1"
  local dest="$src/$CONFIG_FILE"
  [ -d "$src" ] || die "no existe $src"
  git -C "$src" rev-parse --git-dir >/dev/null 2>&1 || die "$src no es un repo git"
  if [ -e "$dest" ]; then
    echo "· ya existe $dest"
  else
    cp "$TEMPLATES/agent-workflow.md" "$dest"
    echo "✓ Creado $dest"
  fi
  if git -C "$src" ls-files --error-unmatch "$CONFIG_FILE" >/dev/null 2>&1; then
    echo "  ! $CONFIG_FILE está commiteado en $1: el exclude no lo saca del repo (git rm --cached $CONFIG_FILE)"
  else
    ensure_config_excluded "$src"
    echo "  Es local: quedó en .git/info/exclude, así que no entra en ningún commit de ningún worktree."
  fi
  echo "  Editalo (branch, commits, PRs, tests, datos sensibles). Los tickets lo ven por symlink;"
  echo "  en uno que ya tenga el worktree de $1, corré ticket add $1 para enlazarlo."
}

cmd_ls() {
  [ -d "$TICKETS_ROOT" ] || { echo "(no hay tickets en $TICKETS_ROOT)"; return 0; }
  local d phase found=0
  for d in "$TICKETS_ROOT"/*/; do
    [ -f "$d.ticket" ] || continue
    found=1
    phase="$(grep -m1 '^fase:' "$d/status.md" 2>/dev/null | sed 's/^fase: *//' || true)"
    ( . "$d.ticket"; printf '%-40s %-16s %s\n' "$(basename "$d")" "${phase:-?}" "${REPOS:-(sin repos)}" )
  done
  [ $found -eq 1 ] || echo "(no hay tickets activos en $TICKETS_ROOT)"
}

cmd_path() {
  [ $# -eq 1 ] || die "uso: ticket path <ID o número de issue>"
  local q="${1#\#}" m
  for m in "$TICKETS_ROOT/$q" "$TICKETS_ROOT/$q"-* "$TICKETS_ROOT"/*-"$q"-*; do
    if [ -f "$m/.ticket" ]; then echo "$m"; return 0; fi
  done
  die "no encontré el ticket $1 en $TICKETS_ROOT"
}

cmd_done() {
  load_ticket
  local repo dest problems=0 base
  for repo in $REPOS; do
    dest="$T/.wt/$repo"
    [ -d "$dest" ] || continue
    if [ -n "$(git -C "$dest" status --porcelain)" ]; then
      echo "✗ $repo: hay cambios sin commitear"; problems=1
    fi
    if ! git -C "$dest" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      # Sin upstream: solo es problema si la branch tiene commits propios
      base="$(git -C "$dest" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo main)"
      if [ -n "$(git -C "$dest" log "$base..HEAD" --oneline 2>/dev/null || echo x)" ]; then
        echo "✗ $repo: la branch tiene commits y no está pusheada (git push -u origin HEAD)"; problems=1
      fi
    elif [ -n "$(git -C "$dest" log '@{u}..' --oneline)" ]; then
      echo "✗ $repo: hay commits sin pushear"; problems=1
    fi
  done
  [ $problems -eq 0 ] || die "resolvé lo de arriba antes de cerrar. Las branches nunca se borran, solo los worktrees."

  for repo in $REPOS; do
    if [ -d "$T/.wt/$repo" ]; then
      git -C "$REPOS_ROOT/$repo" worktree remove "$T/.wt/$repo"
      echo "✓ worktree $repo removido (la branch $BRANCH se conserva)"
    fi
  done
  rmdir "$T/.wt" 2>/dev/null || true
  set_front fase cerrado
  log_status "ticket cerrado"
  mkdir -p "$TICKETS_ROOT/_archive"
  mv "$T" "$TICKETS_ROOT/_archive/"
  echo "✓ Archivado en $TICKETS_ROOT/_archive/$(basename "$T")"
  echo "  (si estabas parado adentro, hacé cd a otro lado)"
}

case "${1:-}" in
  new)      shift; cmd_new "$@" ;;
  add)      shift; cmd_add "$@" ;;
  link)     shift; cmd_link "$@" ;;
  init)     shift; cmd_init "$@" ;;
  ls|list)  cmd_ls ;;
  path)     shift; cmd_path "$@" ;;
  done)     cmd_done ;;
  vault)    ensure_vault; echo "✓ Vault listo en $TICKETS_ROOT (abrilo en Obsidian: Open folder as vault)" ;;
  ""|-h|--help|help) usage ;;
  *)        die "comando desconocido: $1 (probá 'ticket help')" ;;
esac
